# Copy this file to .env in this folder and fill in your own values. .env is git-ignored.

# Required: OpenAI key (chat model and PDF embeddings)
OPENAI_API_KEY=your-openai-api-key

# Required: the Postgres database. This matches docker-compose.yml (`docker compose up -d`).
# For a hosted database (for example Neon or Supabase) put its connection string here instead.
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5433/chatbot

# Optional: chat model name (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: who the app runs as until a login exists (defaults to local-user)
# APP_USER_ID=local-user

# Optional: LangSmith tracing (uncomment these lines to enable it)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=chatbot-project
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for EU accounts
